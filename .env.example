# 拾绪 ShiXu · 服务端 AI 配置示例（复制为 .env.local 使用）
# 仅服务端读取；禁止 NEXT_PUBLIC_ 前缀；真实 Key 不提交、不进日志与前端。
# 官方文档复核：2026-11-13；开发环境缺 MODEL_API_KEY / BAILIAN_WORKSPACE_ID，真实调用未验证。

# 阿里云百炼 API Key（与 Endpoint 地域一致）。未配置时 /api/emotion 返回 503，页面手选闭环可用。
MODEL_API_KEY=

# 决策模型 decision-model-preview 必须使用业务空间专属域名，Workspace ID 必填（账号开通状态未验证）。
# 默认拼接北京地域：https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
BAILIAN_WORKSPACE_ID=

# 可选：完整 base URL 覆盖（不含末尾 /systemone），如新加坡地域：
# https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
MODEL_BASE_URL=

# 候选模型标识（官方文档已核实存在；账号开通状态需真实 Key 验证）
MODEL_NAME=decision-model-preview

# bailian = 默认真实 Provider；mock 仅用于测试/演示，页面明确标注演示数据，走同一原生校验与映射路径
AI_PROVIDER_MODE=bailian

# 服务端保护阈值（可选，默认值如下；计数为单进程内存状态，多实例公开部署必须由平台层叠加同等保护）
AI_MAX_INPUT_CHARS=30000
AI_MAX_BODY_BYTES=33554432
AI_RATE_LIMIT_PER_MINUTE=10
AI_MAX_CONCURRENT=2
AI_CALL_BUDGET=200